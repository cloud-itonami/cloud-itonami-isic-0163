{:paths ["src"]
 ;; No third-party dependency, by design. The actor
 ;; (`src/postharvest/*.cljc`) needs none, and the build-time console
 ;; generator (`postharvest.render-html`) styles itself from the DADS
 ;; primitives this repo ALREADY vendors into `docs/index.html`, so
 ;; regenerating the console works offline (fleet CI nodes have no
 ;; guaranteed egress) and cannot drift away from the product face.
 :deps {}
 :aliases
 {:dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}
        io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}}}
  :run {:main-opts ["-m" "postharvest.sim"]}
  ;; clojure -M:dev:render-html [out-file]
  ;; -> regenerate docs/samples/operator-console.html through the real
  ;;    operation -> governor -> store stack (flagship checklist item 2).
  :render-html {:main-opts ["-m" "postharvest.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
