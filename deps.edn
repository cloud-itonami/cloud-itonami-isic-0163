{:paths ["src"]
 ;; The actor itself (`src/postharvest/*.cljc`) has no third-party
 ;; dependency. jp-go-digital-design-system is needed only by the
 ;; build-time console generator (`postharvest.render-html`), which reads
 ;; the design system's token block and skin rules to style the page
 ;; instead of hand-writing CSS. Pinned to the same sha the rest of the
 ;; cloud-itonami fleet renders with.
 :deps {io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}}
 :aliases
 {:dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}
        io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}}}
  :run {:main-opts ["-m" "postharvest.sim"]}
  ;; clojure -M:dev:render-html [out-file]
  ;; -> regenerate docs/samples/operator-console.html through the real
  ;;    operation -> governor -> store stack (flagship checklist item 2).
  :render-html {:main-opts ["-m" "postharvest.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
